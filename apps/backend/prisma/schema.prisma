generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

enum Brand {
  TOYOTA
  KIA
  CHANGAN
  CHEVROLET
  FORD
  HONDA
  HYUNDAI
  MITSUBISHI
  JEEP
  CHRYSLER
  DODGE
  RAM
  BUICK
  CADILLAC
  LINCOLN
  MERCURY
  PONTIAC
  HUMMER
  VOLKSWAGEN
  AUDI
  BMW
  MERCEDES_BENZ
  PORSCHE
  MINI
  FIAT
  ALFA_ROMEO
  RENAULT
  PEUGEOT
  CITROEN
  SEAT
  SKODA
  ASTON_MARTIN
  LAND_ROVER
  CHERY
  BYD
  GEELY
  GREAT_WALL
  JAC
  JMC
  LIFAN
  WULING
  ZHONGXING
  ZOTYE
  HAFEI
  CHANA
  CHANGHE
  VENIRAUTO
  VIT
  DONGFENG
  FORTHING
  FOTON
  ISUZU
  IVECO
  MACK
}

enum VehicleCategory {
  SUV
  SEDAN
  PICKUP
  HATCHBACK
  COMPACTO
}

enum FuelType {
  GASOLINA
  DIESEL
  HIBRIDO
  ELECTRICO
}

enum TransmissionType {
  MANUAL
  AUTOMATICA
  CVT
  DCT
}

enum DriveType {
  FWD_4X2
  AWD_4X4
}

enum FuelEconomyUnit {
  KM_POR_GAL
  L_POR_100KM
}

model Vehicle {
  id            Int             @id @default(autoincrement())
  brand         Brand
  model         String
  trim          String
  year          Int
  price         Decimal         @db.Decimal(10, 2)
  priceIncludes String?
  mainImageUrl  String
  category      VehicleCategory

  displacementCc     Int?
  cylinders          Int?
  horsepowerHp       Int?
  torqueNm           Int?
  fuelType           FuelType
  transmissionType   TransmissionType
  transmissionSpeeds Int?
  driveType          DriveType

  lengthMm          Int?
  widthMm           Int?
  heightMm          Int?
  wheelbaseMm       Int?
  trunkCapacityL    Int?
  weightKg          Int?
  passengerCapacity Int?

  fuelEconomyValue            Decimal?         @db.Decimal(5, 2)
  fuelEconomyUnit             FuelEconomyUnit?
  fuelEconomyNormalizedKmPerL Decimal?         @db.Decimal(5, 2)
  tankCapacityL               Int?

  airbagsCount        Int?
  hasAbs              Boolean @default(false)
  hasStabilityControl Boolean @default(false)
  hasRearCamera       Boolean @default(false)

  seatType     String?
  hasBluetooth Boolean @default(false)
  hasCarPlay   Boolean @default(false)

  warrantyYears Int?
  warrantyKm    Int?
  highlights    String[]

  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum LeadStatus {
  NUEVO
  CONTACTADO
  CONVERTIDO
  DESCARTADO
}

model Lead {
  id         Int        @id @default(autoincrement())
  firstName  String
  lastName   String
  phone      String
  vehicleIds Int[]
  status     LeadStatus @default(NUEVO)
  // null cuando el Lead vino del Wizard actual; solo se puebla cuando el
  // Agente conversacional lo crea (ver leads/CONTEXT.md).
  profileId  Int?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// needs/motivations/objections son Json (array de {category, detail}) en vez
// de tablas relacionadas — ponytail: MVP, sin queries que filtren por
// categoría todavía; si Analytics necesita agregarlas de verdad, se revisa.
model Profile {
  id          Int      @id @default(autoincrement())
  sessionId   String   @unique
  needs       Json     @default("[]")
  motivations Json     @default("[]")
  objections  Json     @default("[]")
  budgetMin   Int?
  budgetMax   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ConversationStatus {
  ACTIVA
  ABANDONADA
  COMPLETADA
}

// turns es Json (array de {buyerMessage, agentReply}) — misma razón que
// needs/motivations/objections en Profile: MVP, sin necesidad de tabla
// relacionada todavía.
model Conversation {
  id        Int                @id @default(autoincrement())
  sessionId String             @unique
  status    ConversationStatus @default(ACTIVA)
  turns     Json               @default("[]")
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

enum AnalyticsEventType {
  VEHICLE_VIEWED
  VEHICLE_ADDED_TO_COMPARISON
  COMPARISON_PERFORMED
  QUIZ_COMPLETED
  LEAD_SUBMITTED
  NEED_CAPTURED
  MOTIVATION_CAPTURED
  OBJECTION_CAPTURED
  BUDGET_CAPTURED
  FUNNEL_STAGE_REACHED
}

model AnalyticsEvent {
  id         Int                @id @default(autoincrement())
  type       AnalyticsEventType
  sessionId  String?
  vehicleId  Int?
  vehicleIds Int[]
  metadata   Json?
  createdAt  DateTime           @default(now())
}
