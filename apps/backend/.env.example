DATABASE_URL="postgresql://car_dealer:car_dealer@localhost:5433/car_dealer"
PORT=3002
JWT_SECRET="change-me"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Agente conversacional (CEB-42) — ver docs/adr/0011-agent-scoped-not-generic.md
# LLM_PROVIDER selecciona el adapter (agent.module.ts): "kimi" (producción),
# "openai" o "vertex" (pruebas) — mismo LlmPort, swap sin tocar dominio.
LLM_PROVIDER="kimi"

# Kimi / Moonshot AI (solo si LLM_PROVIDER="kimi") — API compatible OpenAI.
KIMI_API_KEY="change-me"
KIMI_MODEL="kimi-k3"
# KIMI_BASE_URL="https://api.moonshot.ai/v1"
# kimi-k3 es un modelo "thinking-only" — low/high/max, default "low" acá
# para mantener latencia razonable en un chat en vivo.
# KIMI_REASONING_EFFORT="low"

# Vertex AI (solo si LLM_PROVIDER="vertex")
GOOGLE_CLOUD_PROJECT="change-me"
GOOGLE_CLOUD_LOCATION="us-central1"
VERTEX_MODEL="gemini-3.6-flash"
# Opcional en local si ya corriste `gcloud auth application-default login`
# (usa Application Default Credentials). En despliegues sobre infraestructura
# de GCP (Cloud Run, GKE con Workload Identity, etc.) tampoco hace falta —
# solo se necesita si el proceso corre fuera de GCP con una service account.
# GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"

# OpenAI (solo si LLM_PROVIDER="openai")
OPENAI_API_KEY="change-me"
OPENAI_MODEL="gpt-4o-mini"
